FROM opendesign-node:24.18.1 AS build
ENV CI=true
RUN test "$(node --version)" = "v24.18.1"
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY scripts/postinstall.mjs ./scripts/postinstall.mjs
COPY packages ./packages
COPY tools ./tools
COPY apps/daemon/package.json ./apps/daemon/package.json
COPY apps/web/package.json ./apps/web/package.json
COPY e2e/package.json ./e2e/package.json
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate && pnpm install --frozen-lockfile
COPY apps ./apps
RUN pnpm --filter @open-design/daemon build && pnpm --filter @open-design/web build && pnpm --filter @open-design/daemon deploy --legacy --prod /app/deploy/daemon
COPY skills ./skills
COPY design-systems ./design-systems
COPY craft ./craft
COPY prompt-templates ./prompt-templates
COPY assets ./assets
COPY plugins/_official ./plugins/_official
FROM opendesign-node:24.18.1
RUN test "$(node --version)" = "v24.18.1"
RUN apt-get update && apt-get install -y --no-install-recommends tini poppler-utils bash git ca-certificates && rm -rf /var/lib/apt/lists/* && groupadd --system --gid 1001 open-design && useradd --system --no-create-home --uid 1001 --gid open-design open-design
WORKDIR /app
COPY --from=build --chown=open-design:open-design /app/deploy/daemon ./apps/daemon
COPY --from=build --chown=open-design:open-design /app/apps/web/out ./apps/web/out
COPY --from=build --chown=open-design:open-design /app/skills ./skills
COPY --from=build --chown=open-design:open-design /app/design-systems ./design-systems
COPY --from=build --chown=open-design:open-design /app/craft ./craft
COPY --from=build --chown=open-design:open-design /app/prompt-templates ./prompt-templates
COPY --from=build --chown=open-design:open-design /app/assets/frames ./assets/frames
COPY --from=build --chown=open-design:open-design /app/assets/community-pets ./assets/community-pets
COPY --from=build --chown=open-design:open-design /app/plugins/_official ./plugins/_official
RUN mkdir -p /app/.od && chown -R open-design:open-design /app
ENV NODE_ENV=production NODE_OPTIONS=--max-old-space-size=192 OD_BIND_HOST=0.0.0.0 OD_PORT=7456
EXPOSE 7456
USER open-design
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 CMD node -e "fetch('http://127.0.0.1:7456/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "apps/daemon/dist/cli.js", "--host", "0.0.0.0", "--no-open"]
